<!DOCTYPE html>
<html lang="fr">
<head>
    <!-- Meta standards pour l'encodage et l'affichage mobile. -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
</head>
<body>
    <!-- Reutilisation de la navigation commune. -->
    <%- include("navbar") %>
    <h1>Authentification :</h1>
    <!-- Titre de la page d'inscription. -->
    <!---->
    <form action="/register" method="post">
        <!-- Formulaire envoye en POST vers /register. -->
        <div class="container">
            <!-- Zone contenant tous les champs du formulaire. -->
            <h3>S'enregistrer</h3>
            <p>Veuillez compléter tous les champs.</p>

            <hr><!-- Insérer une ligne horizontale -->
            <label for="email">Email :</label>
            <input type="text" name="email" id="email" required>

            <!-- Zone de saisie pour le mot de passe -->
            <label for="motdepasse">Mot de passe :</label>
            <input type="password" name="motdepasse" id="motdepasse" required>

            <button type="submit">Enregistrer</button> 
            <!-- Bouton qui envoie les donnees au serveur. -->
        </div>
    </form>
</body>
</html>
